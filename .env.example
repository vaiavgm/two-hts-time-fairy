DISCORD_TOKEN=
FAKE_TOKEN=

# Copy "Now Playing" entries of the Chorus bot (posted in its own server) into a 2HTS channel. All three IDs are needed.
CHORUS_BOT_ID=
CHORUS_CHANNEL_ID=
CHORUS_RELAY_CHANNEL_ID=

AI_ENABLED=false
AI_PROVIDER=anthropic
AI_FALLBACK=openai,gemini
AI_MAX_TOKENS=150
AI_TIMEOUT_MS=15000
AI_SYSTEM_PROMPT=
AI_PROMPTS_FILE=
AI_FALLBACK_FILE=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# Folder where the bot keeps small runtime files (e.g. which default slash commands an admin switched off). Must survive restarts.
DATA_DIR=./data
